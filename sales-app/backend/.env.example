# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=htc_pipeline

# 현재 년도 (자동으로 현재 년도 사용, 필요시 직접 지정)
CURRENT_YEAR=2026

# Google Sheets 설정 (년도별 스프레드시트 ID)
SPREADSHEET_2026=your_2026_spreadsheet_id_here
SPREADSHEET_2027=your_2027_spreadsheet_id_here
# 매년 새 구글시트 만들고 해당 년도의 SPREADSHEET_XXXX에 ID 추가

# Google Credentials 파일 경로 (선택사항)
# GOOGLE_CREDENTIALS_FILE=/path/to/credentials.json

# Optional
# CORS_ORIGINS=http://localhost:3001
# AUTH_SERVICE_URL=http://localhost:8000
